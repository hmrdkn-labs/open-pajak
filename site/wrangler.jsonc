{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-pajak-site",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "routes": [{ "pattern": "open-pajak.hamardikan.com", "custom_domain": true }],
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
